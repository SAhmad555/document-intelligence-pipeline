{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Documents": "Data Source=docintel.db"
  },
  "Extraction": {
    "Provider": "auto"
  },
  "Claude": {
    "Model": "claude-opus-5-5",
    "Effort": "medium",
    "MaxTokens": 16000
  },
  "ReviewPolicy": {
    "RequiredFieldThreshold": 0.85,
    "OptionalFieldThreshold": 0.6,
    "ValidationErrorConfidenceCap": 0.5
  }
}
